#!/usr/bin/env python3
"""Entry point IBus starts (see nukta-bangla.xml). `--standalone` registers the engine at run
time instead, to try it without installing."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from nukta_bangla.ibus_engine import run  # noqa: E402

if __name__ == "__main__":
    run(standalone="--standalone" in sys.argv)
